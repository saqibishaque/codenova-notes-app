{
  "name": "codenova-notes-application",
  "version": "1.0.0",
  "description": "CodeNova Internship - Task 1: End-to-End Client & Server Notes Application",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\"",
    "start": "npm run dev",
    "install:all": "npm install --prefix server && npm install --prefix client",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "seed": "npm run seed --prefix server",
    "build:client": "npm run build --prefix client"
  },
  "keywords": [
    "codenova",
    "internship",
    "task-1",
    "notes-app",
    "react",
    "express",
    "sqlite"
  ],
  "author": "CodeNova Intern",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
